# Proposed /etc/sudoers.d/snc-a2a for the A2-a validation (PREREG.md). NOT INSTALLED until the
# preregistration is approved. Exactly the four root commands of a2a.py ROOT, with their exact
# arguments: one explicit trim of /srv/snc-data, and three read-only state reads (A1).
# Install: sudo install -m 0440 sudoers-snc-a2a /etc/sudoers.d/snc-a2a && sudo visudo -c
solo ALL=(root) NOPASSWD: /usr/sbin/fstrim -v /srv/snc-data, /usr/sbin/smartctl -x /dev/sdb, /usr/bin/sg_logs -a /dev/sdb, /usr/sbin/tune2fs -l /dev/sdb1
